[Unit]
Description=cpa-usage-keeper -> tokscale gjc bridge
After=network.target

[Service]
Type=oneshot
# Edit to match your deployment:
#   --db      path to the keeper SQLite database (app.db)
#   --dest    scanned by tokscale via settings.json extraScanPaths.gjc
ExecStart=/usr/bin/python3 %h/git/cli-proxy/cpa-usage-keeper/scripts/tokscale_bridge.py --db %h/cpa-usage-keeper/data/app.db
